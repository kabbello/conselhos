APP_NAME="Sistema de Conselhos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados (MySQL via Docker)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=conselhos
DB_USERNAME=conselhos
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# Cache e Filas (Redis via Docker)
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
BROADCAST_CONNECTION=log

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Storage
FILESYSTEM_DISK=r2

# Cloudflare R2 (preencher antes do deploy)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=conselhos-municipais
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_URL=https://<dominio-publico-ou-r2.dev>

# E-mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@conselhos.perui.be"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp (Evolution API) — preencher antes do deploy
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=

# Horizon
HORIZON_ENABLED=true

# Super Admin — obrigatório em produção (mínimo 12 caracteres)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
